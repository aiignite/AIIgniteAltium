DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aidrive_altium
# Required: generate an independent random JWT signing key; startup rejects empty/legacy defaults.
SECRET_KEY=
ADMIN_EMAIL=admin@example.com
# Required only when creating the initial admin or explicitly resetting its password.
ADMIN_PASSWORD=
ADMIN_BOOTSTRAP_RESET_PASSWORD=false
# Independent Fernet key: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Back up securely. Never derive this from SECRET_KEY. Empty credentials/mock work without this key.
CREDENTIAL_ENCRYPTION_KEY=
# Exact normalized base URLs, JSON array. Add local gateway/Ollama URLs explicitly; no wildcard/prefix matching.
OUTBOUND_ALLOWED_URLS=["https://api.openai.com/v1","https://api.anthropic.com"]
# DNS preflight checks are not full DNS-rebinding protection; enforce network egress policy in deployment.
DATA_DIR=./data
# Durable parse queue worker runs inside the API process; disable only if a dedicated worker is deployed.
PARSE_WORKER_ENABLED=true
PARSE_POLL_SECONDS=2
